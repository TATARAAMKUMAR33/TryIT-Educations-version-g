# ─────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
# Use SERVICE ROLE key (not anon key) — gives full DB access

# ─────────────────────────────────────────────
# NVIDIA API KEYS (5 keys)
# ─────────────────────────────────────────────
NVIDIA_KEY_1=nvapi-xxxx
NVIDIA_KEY_2=nvapi-xxxx
NVIDIA_KEY_3=nvapi-xxxx
NVIDIA_KEY_4=nvapi-xxxx
NVIDIA_KEY_5=nvapi-xxxx

# ─────────────────────────────────────────────
# GEMINI API KEYS (5 keys)
# ─────────────────────────────────────────────
GEMINI_KEY_1=AIzaxxxx
GEMINI_KEY_2=AIzaxxxx
GEMINI_KEY_3=AIzaxxxx
GEMINI_KEY_4=AIzaxxxx
GEMINI_KEY_5=AIzaxxxx

# ─────────────────────────────────────────────
# GROQ API KEYS (5 keys)
# ─────────────────────────────────────────────
GROQ_KEY_1=gsk_xxxx
GROQ_KEY_2=gsk_xxxx
GROQ_KEY_3=gsk_xxxx
GROQ_KEY_4=gsk_xxxx
GROQ_KEY_5=gsk_xxxx

# ─────────────────────────────────────────────
# GENERATOR SETTINGS
# ─────────────────────────────────────────────
# Which category to start from (leave empty = start from beginning)
START_CATEGORY=
# Delay between API calls in seconds
API_DELAY=1.5
# Max retries per failed generation
MAX_RETRIES=3
# Batch size before Supabase flush
BATCH_SIZE=10
